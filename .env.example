# Copy to .env (permissions 600). Never commit it. deploy/install.sh does this for you.

# Master key that encrypts credentials and secrets in the database.
# Generate one with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy outside the server too: without it, a backup of data/ is useless (to you as well).
MULTICDN_SECRET_KEY=

# Live DNS changes. While true, every change is simulated and only recorded.
MULTICDN_DRY_RUN=true

# Origin IP of each server (it can also be edited in Settings → Servers).
ORIGIN_VPS1_IPV4=

# Email for the Let's Encrypt account (optional, recommended).
MULTICDN_ACME_EMAIL=

# HTTPS-only cookies: auto marks them secure behind tailscale serve.
MULTICDN_COOKIE_SECURE=auto

# Reverse proxies in front of the panel whose X-Forwarded-For is trusted for the client IP
# (login lockouts and "Signed in from …"). 0 (default): the connection's address, right for
# the SSH tunnel. 1: one proxy such as tailscale serve; its right-most entry is used.
# Never 1 if the port can be reached without going through that proxy.
# MULTICDN_TRUSTED_PROXIES=0

# Default language (en or es) for new visitors without a choice of their own, and for
# history and alerts until one is chosen in Settings → Notifications.
# MULTICDN_LANG=en

# Optional error reporting to Sentry or GlitchTip. Without a DSN nothing is sent anywhere.
# Only errors, with IPs, emails and tokens removed. See deploy/README.md, step 8.
# The DSN itself is set in Settings → System (or MULTICDN_SENTRY_DSN in config/secrets.env).
# MULTICDN_SENTRY_ENVIRONMENT=production
# MULTICDN_SENTRY_TRACES_SAMPLE_RATE=0

# Panel log level on stdout (docker compose logs): DEBUG, INFO, WARNING or ERROR.
# MULTICDN_LOG_LEVEL=INFO

# --- Values the panel manages: NOT here ---
# Tokens and alert channels (CLOUDFLARE_API_TOKEN, GCORE_API_TOKEN, TELEGRAM_BOT_TOKEN,
# TELEGRAM_CHAT_ID, SMTP_URL, ALERT_EMAIL_TO, FOOTBALL_DATA_TOKEN, MULTICDN_HEARTBEAT_URL,
# MULTICDN_SENTRY_DSN) live in config/secrets.env, which the panel keeps in sync with what you
# save in it. deploy/install.sh moves them there if they are still in this file.
# See deploy/README.md, "Panel secrets file (config/secrets.env)".
# MULTICDN_SECRETS_DIR=./config     (another folder for secrets.env; also read by Compose)

# Outside Docker (local development): initial YAML inventory and database path.
# MULTICDN_INVENTORY=inventory.yaml
# MULTICDN_DB=data/multicdn.db
