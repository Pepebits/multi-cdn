# Copia a .env (permisos 600). Nunca al repositorio.

# Clave maestra que cifra credenciales y secretos en la base de datos.
# Genera una con: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Guárdala también fuera del VPS: sin ella, una copia de data/ no sirve de nada (y tampoco a ti).
MULTICDN_SECRET_KEY=

# Cambios DNS reales. Mientras sea true, todo se simula y solo se registra.
MULTICDN_DRY_RUN=true

# IP de origen de cada servidor (también se puede editar en Ajustes → Servidores).
ORIGIN_VPS1_IPV4=

# Correo para la cuenta de Let's Encrypt (opcional, recomendado).
MULTICDN_ACME_EMAIL=

# Cookies solo por HTTPS: auto las marca como seguras detrás de tailscale serve.
MULTICDN_COOKIE_SECURE=auto

# --- Opcional: valores por entorno ---
# Lo normal es configurarlos desde el panel (se guardan cifrados). Si se definen aquí,
# se usan cuando el panel no tiene valor propio. Los tokens de proveedor solo se importan
# en el primer arranque.
# CLOUDFLARE_API_TOKEN=
# GCORE_API_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_URL=
# ALERT_EMAIL_TO=
# FOOTBALL_DATA_TOKEN=

# Fuera de Docker (desarrollo local): inventario YAML inicial y ruta de la base de datos.
# MULTICDN_INVENTORY=inventory.yaml
# MULTICDN_DB=data/multicdn.db
