# Copy to .env (permissions 600). Never commit it. deploy/install.sh does this for you.

# Master key that encrypts credentials and secrets in the database.
# Generate one with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy outside the server too: without it, a backup of data/ is useless (to you as well).
MULTICDN_SECRET_KEY=

# Live DNS changes. While true, every change is simulated and only recorded.
MULTICDN_DRY_RUN=true

# Origin IP of each server (it can also be edited in Settings → Servers).
ORIGIN_VPS1_IPV4=

# Email for the Let's Encrypt account (optional, recommended).
MULTICDN_ACME_EMAIL=

# HTTPS-only cookies: auto marks them secure behind tailscale serve.
MULTICDN_COOKIE_SECURE=auto

# Default language (en or es) for new visitors without a choice of their own, and for
# history and alerts until one is chosen in Settings → Operation.
# MULTICDN_LANG=en

# --- Optional: values from the environment ---
# Normally set from the panel (stored encrypted). If set here, they are used while the panel
# has no value of its own. Provider tokens are only imported on the first start.
# CLOUDFLARE_API_TOKEN=
# GCORE_API_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SMTP_URL=
# ALERT_EMAIL_TO=
# FOOTBALL_DATA_TOKEN=

# Outside Docker (local development): initial YAML inventory and database path.
# MULTICDN_INVENTORY=inventory.yaml
# MULTICDN_DB=data/multicdn.db
