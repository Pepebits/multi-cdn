[Unit]
Description=Multi-CDN: limita los puertos web del origen a los CDN y actualiza los proxies de Caddy
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/multicdn-firewall.sh apply
# Si falla (p. ej. sin red al arrancar), reintenta cada 5 min en vez de esperar al temporizador
# (24 h). Type=oneshot admite Restart=on-failure desde systemd 244.
Restart=on-failure
RestartSec=5min
