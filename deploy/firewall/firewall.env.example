# Copia a /etc/multicdn/firewall.env (opcional: sin él se usan estos valores).

# Puertos web protegidos (TCP y UDP, para HTTP/3).
PORTS="80, 443"

# Interfaces de confianza: su tráfico nunca se filtra.
ALLOW_INTERFACES='"lo", "tailscale0"'

# IPs extra con acceso directo a 80/443 (p. ej. una sonda propia). Separadas por espacios.
EXTRA_ALLOW_V4=""
EXTRA_ALLOW_V6=""

# 1 cuando se añada Fastly como respaldo.
INCLUDE_FASTLY=0

# Si una lista nueva tiene menos de este % de entradas que la última buena, no se aplica.
MIN_RATIO=50

# Fichero de proxies de confianza para Caddy (vacío: no tocar Caddy). Solo se recarga Caddy
# si el fichero cambia y `caddy validate` pasa.
CADDY_RANGES=/etc/caddy/cdn-ranges.caddy
CADDYFILE=/etc/caddy/Caddyfile
CADDY_ENVFILE=/etc/caddy/caddy.env

# Carpeta de datos del panel: allí se deja firewall-status.json y se recoge la petición de
# actualización inmediata (firewall-refresh-request).
PANEL_DATA=/var/www/multi-cdn/data
